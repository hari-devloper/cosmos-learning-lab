flowchart TB
  %% COSMOS-ARCH-001-TX — detailed transaction lifecycle.
  %% Based on official Cosmos SDK documentation; validate exact behavior against the chosen release.
  %% References:
  %% - https://github.com/cosmos/cosmos-sdk-docs/blob/main/docs/learn/concepts/lifecycle.md
  %% - https://github.com/cosmos/cosmos-sdk-docs/blob/main/docs/learn/advanced/00-baseapp.md
  %% - https://github.com/cosmos/cosmos-sdk-docs/blob/main/docs/learn/beginner/00-app-anatomy.md

  subgraph CLIENT["1. Client preparation"]
    A["Create message(s)"]
    B["Build Tx: messages, signer info, sequence, fee, gas limit"]
    C["Encode transaction and sign required bytes"]
    A --> B --> C
  end

  subgraph ADMISSION["2. Asynchronous admission path"]
    D["Submit signed transaction to node"]
    E["CheckTx: decode + configured AnteHandler checks"]
    F{"Admission accepted?"}
    G["Rejected from mempool; no settlement execution"]
    H["Mempool: candidate transaction"]
    D --> E --> F
    F -- "No" --> G
    F -- "Yes" --> H
  end

  subgraph PROPOSAL["3. Block proposal and consensus"]
    I["PrepareProposal: proposer selects/builds transaction list"]
    J["ProcessProposal: validators check proposed block"]
    K{"Proposal accepted by consensus?"}
    L["Reject proposal / continue consensus rounds"]
    M["CometBFT reaches agreement on a block"]
    H --> I --> J --> K
    K -- "No" --> L
    L -. "new proposal/round" .-> I
    K -- "Yes" --> M
  end

  subgraph EXECUTION["4. Deterministic application execution — FinalizeBlock"]
    N["BaseApp begins block finalization"]
    O["PreBlock hooks, if configured"]
    P["BeginBlock hooks, if configured"]
    Q["For each transaction in committed block: decode and create execution context"]
    R["AnteHandler: configured checks and ante effects"]
    S{"Ante phase succeeds?"}
    T["Skip successful message execution for this tx; record failure result"]
    U["Msg router dispatches each message to its registered Msg service"]
    V["Settlement handler checks institution authorization and domain invariants"]
    W{"All messages succeed?"}
    X["Discard failed message-state branch; preserve only effects allowed by actual SDK semantics"]
    Y["Accept message-state branch: apply staged settlement changes"]
    Z["Continue with remaining transactions in block"]
    AA["EndBlock hooks, if configured"]
    N --> O --> P --> Q --> R --> S
    S -- "No" --> T --> Z
    S -- "Yes" --> U --> V --> W
    W -- "No" --> X --> Z
    W -- "Yes" --> Y --> Z
    Z --> AA
  end

  subgraph PERSIST["5. State persistence and observable result"]
    AB["FinalizeBlock returns transaction results, events, updates and application commitment data"]
    AC["CometBFT persists block and consensus-side results"]
    AD["Commit: application persists committed state"]
    AE["Next height proceeds from the committed state"]
    AF["Indexer consumes committed source and performs idempotent projection"]
    AG[("PostgreSQL read model")]
    AH["Explorer / institution query / reports"]
    AI["Reconciliation compares source chain facts with projection"]
    AJ["Repair by replay, backfill or rebuild; never edit chain history to match SQL"]
    AA --> AB --> AC --> AD --> AE
    AE --> AF --> AG --> AH
    AE --> AI
    AG --> AI --> AJ --> AF
  end

  C --> D
  M --> N

  NOTE1["Important: CheckTx acceptance is not inclusion, successful execution, or settlement."]
  NOTE2["A block can commit even when an individual transaction's message execution fails."]
  NOTE3["Exact fee/sequence/ante effects on failure depend on SDK version and cache boundaries; verify with source and tests."]
  NOTE4["FinalizeBlock executes the decided block; Commit persists application state. Do not collapse these into one step."]
  F -.-> NOTE1
  T -.-> NOTE2
  X -.-> NOTE3
  AB -.-> NOTE4

  classDef success fill:#e6f5e8,stroke:#287443,color:#12351d,stroke-width:2px;
  classDef fail fill:#ffedeb,stroke:#b33a3a,color:#571b1b;
  classDef caution fill:#fff2d9,stroke:#a45d00,color:#492900;
  class M,AD,AE,Y success;
  class G,L,T,X fail;
  class NOTE1,NOTE2,NOTE3,NOTE4,F,S,W caution;

flowchart LR
  %% Module 5 — high-level architecture overview.
  %% Deliberately excludes internal lifecycle detail; see the transaction execution diagram.
  subgraph CLIENT["Client boundary"]
    A["Bank / institution client"]
    B["Build and sign transaction"]
    A --> B
  end

  subgraph CONSENSUS["CometBFT node and consensus"]
    C["Submit transaction"]
    D["CheckTx / mempool admission"]
    E["Validators order and agree on a block"]
    C --> D --> E
  end

  subgraph APP["Cosmos SDK application"]
    F["ABCI request boundary"]
    G["BaseApp executes block transactions"]
    H["AnteHandler checks transaction-level rules"]
    I["Message router dispatches message"]
    J["Settlement module validates business rules"]
    K["Keeper reads/writes application state"]
    F --> G --> H --> I --> J --> K
  end

  subgraph DURABLE["Committed chain state"]
    L["Commit application state"]
    M["Committed block, results and state commitment"]
    L --> M
  end

  subgraph PROJECTION["Off-chain read model"]
    N["Indexer reads committed chain data"]
    O["Idempotent projection + checkpoint"]
    P[("PostgreSQL")]
    Q["Explorer / reports / bank queries"]
    R["Reconciliation: compare and repair projection"]
    N --> O --> P --> Q
    M --> N
    M --> R
    P --> R
    R -. "replay / backfill / rebuild" .-> N
  end

  B --> C
  E --> F
  K --> L

  X["Authority rule: committed chain application state is authoritative"]
  Y["PostgreSQL and UI are derived, rebuildable views"]
  X --- M
  Y --- P

  Z["IBC / cross-chain settlement: later phase, after single-chain correctness and recovery are proven"]
  Z -. "out of initial scope" .-> APP

  classDef authority fill:#e5f4e8,stroke:#287443,color:#12351d,stroke-width:2px;
  classDef projection fill:#eaf1ff,stroke:#3e63a8,color:#142b50;
  classDef caution fill:#fff2d9,stroke:#a45d00,color:#492900;
  class M,X authority;
  class N,O,P,Q,R,Y projection;
  class D,Z caution;
